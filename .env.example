# Copy this file to .env and fill in your own values. Never commit .env!
TELEGRAM_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434
LLM_PROVIDER=gemini
# Models users can choose from (web app, /demo, Telegram /model): provider:model, comma-separated, first = default.
# Empty = only GEMINI_MODEL / OLLAMA_MODEL. If the chosen model is busy, the next ones in the list answer.
LLM_MODELS=gemini:gemini-3.5-flash-lite,gemini:gemini-3.5-flash,gemini:gemini-3.6-flash
# With a local model (Ollama running, after `ollama pull qwen3.5:4b`), e.g. as the backup when Gemini is busy:
# LLM_MODELS=gemini:gemini-3.5-flash-lite,ollama:qwen3.5:4b=Qwen 3.5 4B (local),gemini:gemini-3.6-flash
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ADMIN_IDS=
# Optional: Google Sheets shared as "Anyone with the link: Viewer" (paste the normal sheet link)
SHEET_CSV_URL=
SHEET_QUERIES_URL=
# Optional: Telegram API for reading seller channels (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
# Website / Telegram Mini App / demo (python web.py). WEBAPP_URL = the public https:// address of the site;
# when it is set, the bot shows an "Open app" button. RUN_BOT=0: web.py serves the site without polling the bot.
WEBAPP_URL=
HOST=127.0.0.1
PORT=8080
RUN_BOT=1
# The "How it works" page at /demo and its API (/api/demo/...). 0 turns it off.
ENABLE_DEMO=1

# Optional: Google Maps Platform key with the "Places API (New)" enabled. Map links then open the exact Google Maps
# listing (photos, reviews). Needs WEBAPP_URL to be a public https:// address. Empty = plain search links.
GOOGLE_MAPS_API_KEY=

# Voice: speak a question in Khmer or English (transcribed by Gemini) and hear the answer (edge-tts voices).
# VOICE_ENABLED=0 hides the microphone. STT_MODEL empty = the first Gemini model of LLM_MODELS.
VOICE_ENABLED=1
STT_MODEL=
EDGE_VOICE_KH_FEMALE=km-KH-SreymomNeural
EDGE_VOICE_KH_MALE=km-KH-PisethNeural
EDGE_VOICE_EN_FEMALE=en-US-JennyNeural
EDGE_VOICE_EN_MALE=en-US-GuyNeural
