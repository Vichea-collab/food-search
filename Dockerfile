# Generated by food_search.ipynb (section 9, Export). Edit the notebook and re-run the export, not this file.
# Website / Telegram Mini App + demo + Telegram bot in one image.   Build: docker build -t food-bot .
# Run (secrets come from the host, never from the image):  docker run --env-file .env -p 8080:8080 food-bot
# Bot only (no website):  docker run --env-file .env food-bot python backend/bot.py

# ---- 1. build the React frontend (only its output, frontend/dist, goes into the final image) ----
FROM node:22-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ---- 2. the Python app ----
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/app/.cache/huggingface HOST=0.0.0.0 PORT=8080
WORKDIR /app

# CPU-only torch keeps the image small (the default Linux wheel bundles CUDA, several GB)
COPY requirements.txt .
RUN pip install --no-cache-dir torch==$(grep '^torch==' requirements.txt | cut -d= -f3) \
        --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements.txt

# Cache the embedding model in an image layer so containers start fast and work offline.
# Change EMBED_MODEL here AND at runtime if you switch models (e.g. BAAI/bge-m3).
ARG EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('${EMBED_MODEL}')"

COPY backend/ backend/
COPY --from=frontend /frontend/dist frontend/dist/
COPY data/ data/
# The dish photo model (food_classification.ipynb) and the 101 dish names. Without the .pt file the app
# uses CLIP zero-shot, which is downloaded on first use: run the app once with internet, or train the model.
COPY models/ models/
# Prebuilt vector index from the notebook (init() only refreshes it)
COPY chroma_db/ chroma_db/

EXPOSE 8080
CMD ["python", "backend/web.py"]
